# API Keys — NUNCA commitear `.env` real; este es solo la plantilla.
# Copia a `.env` y completa los valores.

# Proveedor LLM (OpenRouter). Obligatorio para el nodo llm_classify.
OPENROUTER_API_KEY=sk-or-v1-

# Modelo del LLM de decisión de casos (fraude en compensaciones).
# Override de `model` en src/config/model.yaml.
MODEL_FRAUD=qwen/qwen3.7-flash

# Modelo usado por el generador de datos sintéticos (notebook 05).
MODEL_SYNTHETIC_DATA=meta-llama/llama-3.1-8b-instruct

# Overrides opcionales de src/config/model.yaml (12-factor).
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=2048
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT_SECONDS=30
# LLM_MAX_CONCURRENCIA=5
# LLM_INTENTOS_PARSING=2
# LLM_PROMPT_FILE=llm_system.txt
# LLM_EXAMPLES_FILE=llm_examples.md
